AS $function$
DECLARE
    d public.devices%ROWTYPE;
BEGIN
    SELECT *
    INTO d
    FROM public.devices
    WHERE device_id = p_device_id
      AND is_active = true
      AND secret_hash = encode(
          sha256(convert_to(p_secret, 'utf8')),
          'hex'
      );

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown device'
        USING ERRCODE = '28000';
    END IF;

    -- Device must be registered to a user.
    IF d.user_id IS NULL THEN
        RAISE EXCEPTION 'Device must be registered before uploading'
        USING ERRCODE = '28000';
    END IF;

    -- Verify that the fish type is valid.
    IF NOT EXISTS (
